# Copy this file to .env and fill in YOUR values. Never commit .env.
PORT=5000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=sias
DB_PASSWORD=change_me
DB_NAME=sias_db

# Long random string, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Frontend origin(s) allowed by CORS (comma separated)
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run db:seed` to create the first admin
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
