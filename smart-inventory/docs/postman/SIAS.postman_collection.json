          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "",
                "disabled": true
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/products"
          }
        }
