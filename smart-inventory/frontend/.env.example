# Only PUBLIC values belong here: anything prefixed VITE_ is bundled into the browser code.
# NEVER put secrets (JWT secret, DB password) in a VITE_ variable.
# Leave empty in development (the Vite proxy forwards /api to localhost:5000).
# In production set it to your deployed backend, e.g. https://your-api.onrender.com/api/v1
VITE_API_URL=
